# Copia este archivo a .env y rellena los valores.
# Nunca subas .env al repositorio.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# IDs numéricos separados por coma. No uses usernames.
# Tu ID: habla con @userinfobot en Telegram.
TELEGRAM_ALLOWED_USER_IDS=

# --- MQTT (broker local o remoto) ---
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
# Producción (Oracle): mqtts://127.0.0.1:8883 — ver docs/DEPLOY.md
MQTT_URL=
MQTT_USERNAME=smartac
MQTT_PASSWORD=smartac

# --- Backend ---
PORT=3000
# mock (sin ESP32) o mqtt
TRANSPORT=mock
# URL pública HTTPS (DuckDNS + Caddy). Vacío en local / long polling.
PUBLIC_BASE_URL=
DATABASE_URL=file:./data/smart-ac.sqlite
API_SECRET=dev-secret-change-me

# --- Firmware ESP32 (se flashea en el dispositivo, no en Git) ---
WIFI_SSID=
WIFI_PASSWORD=
DEVICE_ID=ac-controller
